// Mookies kiosk report Worker. No secrets live here.
// GOOGLE_PRIVATE_KEY is a Worker secret (the same service-account key the
// website uses): npx wrangler secret put GOOGLE_PRIVATE_KEY
// The deploy workflow (.github/workflows/deploy.yml) sets it from the GitHub
// secret of the same name.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mookies-kiosk",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // kiosk.mookiesoatmealcookies.com (Cloudflare creates the DNS record on the
  // first deploy). The workers.dev address stays on as a backup link.
  "workers_dev": true,
  "routes": [{ "pattern": "kiosk.mookiesoatmealcookies.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    // Maan's accounting Sheet ("Accounting file for Mookies_2026_NEW with Claude").
    // Reports go to its Income & Expense tab. It must be shared with the
    // service account below as Editor.
    "SHEET_ID": "10KQqNf0uhDQHOVCl5wZNm0DaCXvVqJFCAFcNP9UCzZ8",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL": "mookies-orders@mookies-orders.iam.gserviceaccount.com"
  },
  // No scheduled jobs: reports are written straight into the sheet. An empty
  // list removes the old 5-minute LEDGER job from Cloudflare.
  "triggers": { "crons": [] }
}
